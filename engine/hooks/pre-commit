#!/bin/sh
# Engine pre-commit guard: nothing personal may be committed into the engine repo.
#
# Runs `doctor.py --share`, which FAILs when a personal term (the user's name, git email, or a word
# in user/profile/private_terms.txt) appears in any file the engine tracks or has staged — the
# staged copy included, so the check sees what is actually being committed. Any other doctor FAIL
# (a dangling path, a broken @import, a tool that no longer compiles) blocks the commit too.
#
# Installed per clone, because git never copies hooks:
#     git config core.hooksPath engine/hooks
# doctor.py warns while it is not installed. Bypass for one commit only with `git commit --no-verify`,
# and only when you know why the check is wrong.

ROOT=$(git rev-parse --show-toplevel) || exit 1
PY=$(command -v python || command -v python3)
if [ -z "$PY" ]; then
    echo "pre-commit: no python on PATH — cannot run the share check, refusing the commit." >&2
    exit 1
fi

if ! "$PY" "$ROOT/engine/tools/doctor.py" --share; then
    echo "" >&2
    echo "pre-commit: doctor.py --share failed. Fix the FAIL lines above — personal content belongs in" >&2
    echo "user/, not in the engine." >&2
    exit 1
fi
